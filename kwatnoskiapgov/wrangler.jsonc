{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apgov-classroom",
  "main": "api/worker.js",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOMS",
        "class_name": "Classroom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Classroom"
      ]
    }
  ],
  "assets": {
    "directory": "../apgovelections",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
